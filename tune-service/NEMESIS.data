[nemesis]
version=1.0.0
id=tilepad
name=Tilepad
types=application,service
preinstall=scripts/preinstall.sh
postinstall=scripts/postinstall.sh
preuninstall=scripts/preuninstall.sh

[app.0]
kind=sh
path=bin/open.sh
uid=root

[service.0]
name=knobd
kind=sh
path=svc/knobd.sh
uid=root
mode=restart

[service.1]
name=adbgated
kind=sh
path=svc/adbgated.sh
uid=root
mode=restart
